{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "walmart-adf1"
		},
		"LS_ADLS_Gen2_Bronze_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://walmartdata.dfs.core.windows.net/"
		},
		"LS_Azure_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://walmart-key.vault.azure.net/"
		},
		"TR_Nightly_Batch_properties_PL_Master_Batch_Ingestion_parameters_run_date": {
			"type": "string",
			"defaultValue": "@formatDateTime(trigger().scheduledTime,'yyyy-MM-dd')"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "walmart-adf1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Gen2_Bronze_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Gen2_Bronze_properties_typeProperties_url')]"
					},
					"LS_Azure_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_Azure_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"TR_Nightly_Batch_properties_PL_Master_Batch_Ingestion_parameters_run_date": {
						"value": "[parameters('TR_Nightly_Batch_properties_PL_Master_Batch_Ingestion_parameters_run_date')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}