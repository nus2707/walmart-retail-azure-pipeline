{
	"name": "PL_Validate_CRM",
	"properties": {
		"activities": [
			{
				"name": "Check_CRM_File_Exists",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Bronze_CRM_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"run_date": "@pipeline().parameters.run_date"
						}
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "ParquetReadSettings"
					}
				}
			},
			{
				"name": "If_File_Exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check_CRM_File_Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('Check_CRM_File_Exists').output.exists",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Skip Reason",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "skip_reason",
								"value": "@concat('CRM file not found for ', pipeline().parameters.run_date, ' — skipping (runs Mondays only)')"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy_CRM_To_Silver_Staging",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ParquetSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "ParquetReadSettings"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Bronze_CRM_Parquet",
									"type": "DatasetReference",
									"parameters": {
										"run_date": "@pipeline().parameters.run_date"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Bronze_CRM_Parquet",
									"type": "DatasetReference",
									"parameters": {
										"run_date": "@pipeline().parameters.run_date"
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"run_date": {
				"type": "string",
				"defaultValue": "@formatDateTime(utcNow(),'yyyy-MM-dd')"
			}
		},
		"variables": {
			"skip_reason": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-05-19T10:54:23Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}